# 跨平台换行规范化：文本统一 LF，二进制不转换
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.js text eol=lf

# 二进制产物不做换行转换
*.png binary
*.jpg binary
*.gif binary
*.pptx binary
*.pt binary
*.pth binary
*.zip binary
*.npz binary
*.sqlite3 binary
